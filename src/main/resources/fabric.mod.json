{
	"schemaVersion": 1,
	"id": "paramax",
	"version": "${version}",
	"name": "ParaMax",
	"description": "Performance & optimization mod focused mainly on frame pacing.",
	"authors": ["AliensToEarth"],
	"license": "Apache-2.0 license",
	"icon": "assets/paramax/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.alienstoearth.paramax.ParaMaxClient"],
		"modmenu": ["dev.alienstoearth.paramax.modmenu.ParaMaxModMenu"]
	},
	"mixins": [
		{
			"config": "paramax.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~1.21.3",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"sodium": "*",
		"lithium": "*",
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"GitHub": "https://github.com/AliensToEarth",
				"Source": "https://github.com/AliensToEarth/ParaMax"
			}
		}
	}
}
